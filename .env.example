# Kopieren nach .env und anpassen
ADMIN_PASSWORD=ein-sicheres-passwort
SESSION_SECRET=lange-zufaellige-zeichenfolge
DB_PASSWORD=ein-datenbank-passwort
# Beispiel-Abfrage mit Demo-Teilnehmern beim ersten Start anlegen (true/false)
SEED_DEMO=true
PORT=3000
# Betrieb unter einem Unterpfad (z. B. https://localoot.de/wissen) -> /wissen, sonst leer lassen
BASE_PATH=

# Startwert für die freigegebenen Sprachen (Komma-getrennt, Deutsch ist immer die Quelle).
# Danach werden die Sprachen im Admin-Bereich unter „Sprachen“ freigegeben; diese Auswahl hat Vorrang.
ENABLED_LANGS=en,pl,tr,ro,fr,es,it,nl,cs,hu,ru,uk,ar
# Übersetzer: Standard ist der Container „translate“ (LibreTranslate, kostenlos, Texte bleiben im Haus).
# Optional für bessere Qualität: DeepL-Schlüssel eintragen, dann wird DeepL genutzt (Texte gehen an DeepL).
TRANSLATE_URL=http://translate:5000
DEEPL_API_KEY=
# Sprachen, die der Übersetzer-Container lädt (Speicherbedarf!). Leer = wie ENABLED_LANGS. Neue Sprachen hier ergänzen und `translate` neu starten.
TRANSLATE_LOAD_LANGS=
