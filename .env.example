# Kopieren nach .env und anpassen
ADMIN_PASSWORD=ein-sicheres-passwort
SESSION_SECRET=lange-zufaellige-zeichenfolge
DB_PASSWORD=ein-datenbank-passwort
# Beispiel-Abfrage mit Demo-Teilnehmern beim ersten Start anlegen (true/false)
SEED_DEMO=true
PORT=3000
# Betrieb unter einem Unterpfad (z. B. https://localoot.de/wissen) -> /wissen, sonst leer lassen
BASE_PATH=
